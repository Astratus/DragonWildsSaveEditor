# --- Game saves and backups (personal data: never commit) ---
*.sav
*.sav.backup
*.backup
*.verbackup
*.pyedit.bak
backups/
saves/

# Character saves are plain .json: ignore any .json at the top level and in
# common drop folders. Bundled package data and the synthetic tests/fixtures/ stay tracked.
/*.json
*#*.json
!dragonwilds_save_editor/data/*.json
!dragonwilds_save_editor/data/catalog/*.json
!tests/fixtures/*.json

# Snapshots / logs written by older builds next to the code
dw_gui_error.log
*.log

# --- Python / build ---
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Local tooling / secrets ---
.env
.env.*
.claude/
.vscode/
.idea/
Thumbs.db
desktop.ini
